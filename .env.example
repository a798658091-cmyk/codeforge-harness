# Copy this file to .env. Never commit a real key.
CODEFORGE_MODEL=your-model-id
CODEFORGE_API_KEY=your-api-key

# DeepSeek example:
# CODEFORGE_MODEL=deepseek-v4-pro
# CODEFORGE_BASE_URL=https://api.deepseek.com

# OpenAI-compatible endpoints can use the same variables.
# CODEFORGE_BASE_URL=https://your-provider.example/v1

CODEFORGE_MAX_TOKENS=4096
CODEFORGE_REQUEST_TIMEOUT=60

# Day 2 security defaults: read/search are allowed; other tools ask.
CODEFORGE_PERMISSION_DEFAULT=ask
CODEFORGE_PERMISSION_RULES=read_file=allow,search=allow
CODEFORGE_AUDIT_LOG=.codeforge/audit.jsonl
